#!/usr/bin/env python3
"""Serialize Android device access across concurrent agents.

Hook mode reads a PreToolUse payload on stdin and allows, warns, or denies; given
a SessionEnd payload, it releases the ending session's leases.
CLI mode (list/release/steal) is for agents and for you.
"""
import json
import os
import re
import shlex
import shutil
import sys
import time

DIR = os.path.expanduser(os.environ.get("DEVLEASE_DIR", "~/.android-devlease"))
# ponytail: idle TTL only, no in-flight tracking. PostToolUse fires when the tool
# call returns, which for a backgrounded Gradle run is long before the suite ends,
# so it cannot mark a run's real end. The TTL must therefore exceed the longest
# single command (a full Maestro suite). `devlease steal` covers a stuck lease.
TTL = int(os.environ.get("DEVLEASE_TTL", 3600))
WAIT = int(os.environ.get("DEVLEASE_WAIT", 50))

ME = os.environ.get("CLAUDE_CODE_SESSION_ID", "unknown")

# adb subcommands that reconfigure the whole adb server or reboot a device: one
# agent running these breaks every other agent's session, so no lease justifies them.
GLOBAL_SUBCOMMANDS = {"kill-server", "start-server", "root", "unroot", "reboot",
                      "usb", "tcpip", "disconnect"}
ADB_LOCAL = {"devices", "version", "help"}
MAESTRO_LOCAL = {"start-device", "download-samples", "login", "logout", "upload",
                 "cloud"}
ANDROID_DEVICE_SUBCOMMANDS = {"install", "run", "screen", "layout"}
# Anchored at the start of the task name: assembleDebugAndroidTest and
# compileDebugAndroidTestKotlin build the test APK without touching a device.
GRADLE_TASK = re.compile(r"^(?:install|uninstall|connected)")

# Commands that run another command, so the real target is further along.
WRAPPERS = {"env", "timeout", "gtimeout", "nice", "nohup", "stdbuf", "sudo",
            "command", "xargs", "time", "exec"}
SHELLS = {"bash", "sh", "zsh", "dash", "ksh"}
KEYWORDS = {"if", "then", "elif", "else", "while", "until", "do"}
OPERATORS = {"|", "||", "&&", ";", ";;", "&", "(", ")", "{", "}", "!", "\n", "<(", ">("}
# shlex keeps a run of these together (`;>`, `&&\n`), so OPERATOR splits the run.
PUNCTUATION = "();<>|&\n"
OPERATOR = re.compile(r"[<>]\(|&?[<>][<>&|]*|&&|\|\||;;|[();|&\n]")
# A redirection operator once split out: `>`, `>>`, `<`, `>&`, `&>`, `<<<`, `>|`.
REDIRECT = re.compile(r"^&?[<>][<>&|]*$")
# `<<WORD`, `<<-WORD`, `<<\WORD`, `<< 'WORD'`, `<<"WORD"`, but not the here-string `<<<`.
HEREDOC = re.compile(r"(?<!<)<<(?!<)(-?)\s*\\?(['\"]?)(\w[\w.-]*)\2")
SUBSTITUTION = re.compile(r"\$\(((?:[^()]|\([^()]*\))*)\)|`([^`]*)`")
# A '…' holding a `"` may be a mispaired apostrophe, so it stays and is gated.
LITERAL = re.compile(r"""\\.|"(?:\\.|[^"\\])*"|'[^'"]*'""", re.S)
# An unquoted `#` at a word start comments out the line; one holding `"`, `` ` `` or `)`
# may sit in a nested quote this cannot see, so it is kept and gated.
COMMENT = re.compile(r"""\\.|"(?:\\.|[^"\\])*"|'[^']*'|(?<!\S)#[^\n"`)]*$""", re.S | re.M)
ASSIGNMENT = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*=")
WRAPPER_ARG = re.compile(r"^-|^[\d.]+[smhd]?$")

RULE_KEYS = ("denied", "gated", "emulator_only")


def config_home():
    return os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")


def load_rules(cwd):
    """Project and personal rules, concatenated.

    Project rules live in <cwd>/.devlease.json so they travel with the repo;
    personal ones in $XDG_CONFIG_HOME/devlease/config.json. A missing,
    malformed, or partly invalid file costs you those rules and nothing else —
    the built-in gating still applies.
    """
    rules = {key: [] for key in RULE_KEYS}
    paths = [os.path.join(config_home(), "devlease", "config.json")]
    if cwd:
        paths.insert(0, os.path.join(cwd, ".devlease.json"))
    for path in dict.fromkeys(paths):
        try:
            with open(path) as handle:
                data = json.load(handle)
        except Exception:
            continue
        for key in RULE_KEYS:
            for pattern in data.get(key) or []:
                try:
                    rules[key].append((re.compile(pattern), path))
                except (re.error, TypeError):
                    print(f"devlease: bad {key} pattern {pattern!r} in {path}",
                          file=sys.stderr)
    return rules


def matches(rules, cmd):
    """First matching rule as "<pattern> in <config file>", or None."""
    return next((f"{p.pattern} in {path}" for p, path in rules if p.search(cmd)),
                None)



def segments(cmd, depth=0):
    """Simple commands in cmd as (as_written, name, args, assignments).

    Splitting the way a shell would is the whole point: a device command that
    appears inside a quoted argument — `grep "adb kill-server"`, `sed` editing a
    script that mentions adb — is an argument, not a command, and must not be
    gated. Returns None if the command cannot be parsed.
    """
    text = COMMENT.sub(lambda m: "" if m[0][0] == "#" else m[0], drop_heredoc_bodies(cmd))
    # The shell drops a `\` and newline pair, so `ad\⏎b` is `adb`.
    # ponytail: this also joins after an escaped `\\`, where the shell keeps the newline.
    text = text.replace("\\\n", "")
    try:
        lexer = shlex.shlex(text, posix=True, punctuation_chars=PUNCTUATION)
        # Newlines end commands, as `;` does, so they are punctuation, not whitespace.
        lexer.whitespace_split, lexer.commenters, lexer.whitespace = True, "", " \t\r"
        tokens = list(lexer)
    except ValueError:
        return None
    out = []
    if depth < 4:
        # The shell runs "$( … )" and backticks inside double quotes, not single or escaped ones.
        unquoted = LITERAL.sub(lambda m: "" if m[0][0] == "'" else re.sub(r"\\.", "", m[0]), text)
        for dollar, backtick in SUBSTITUTION.findall(unquoted):
            out.extend(segments(dollar or backtick, depth + 1) or [])
    groups, current = [], []
    for token in tokens:
        # ponytail: shlex drops quotes, so a quoted "&&" or ";" splits too; that fails closed.
        pieces = OPERATOR.findall(token) if token and set(token) <= set(PUNCTUATION) else [token]
        for piece in pieces:
            if piece in OPERATORS:
                if current:
                    groups.append(current)
                current = []
            else:
                current.append(piece)
    if current:
        groups.append(current)
    for group in groups:
        out.extend(_simple(drop_redirections(group), depth))
    return out


def drop_heredoc_bodies(cmd):
    """cmd without heredoc bodies, comment lines blanked: both are data, not commands.

    An unclosed `<<WORD` (in quotes, `$((1<<n))`) was no heredoc: cmd comes back whole.
    ponytail: no quote tracking, so a quoted `<<WORD` a later WORD line closes, a `#` line
    in a multi-line quote, and a `$( … )` in an unquoted body can each hide a command.
    """
    kept, pending = [], []
    for line in cmd.split("\n"):
        if pending:
            strip_tabs, word = pending[0]
            if (line.lstrip("\t") if strip_tabs else line) == word:
                pending.pop(0)
            continue
        if line.lstrip().startswith("#"):
            line = ""  # not dropped: a `\` above it must not join the line below
        kept.append(line)
        pending = [(dash == "-", word) for dash, _, word in HEREDOC.findall(line)]
    return cmd if pending else "\n".join(kept)


def drop_redirections(tokens):
    """tokens as the program receives them: the shell removes `>log`, `2>&1`, `<in`."""
    out, skip = [], False
    for token in tokens:
        if skip:
            skip = False
        elif REDIRECT.match(token):
            # ponytail: `2>&1` splits into `2`, `>&`, `1`, so `echo 2 >x` loses its `2` too.
            if out and len(out[-1]) == 1 and out[-1].isdigit():
                out.pop()
            skip = True  # the target is the next word
        else:
            out.append(token)
    return out


def _simple(tokens, depth):
    assignments = {}
    while tokens and ASSIGNMENT.match(tokens[0]):
        key, value = tokens[0].split("=", 1)
        assignments[key] = value
        tokens = tokens[1:]
    if not tokens:
        return []
    written, args = tokens[0], tokens[1:]
    name = os.path.basename(written)

    if written in KEYWORDS and depth < 4:
        return _simple(args, depth + 1)

    if name in WRAPPERS and depth < 4:
        rest = args
        while rest and WRAPPER_ARG.match(rest[0]):
            rest = rest[1:]
        inner = _simple(rest, depth + 1)
        if inner:
            for item in inner:
                item[3].update(assignments)
            return inner

    if name in SHELLS and depth < 4 and "-c" in args:
        index = args.index("-c")
        if index + 1 < len(args):
            nested = segments(args[index + 1], depth + 1)
            if nested:
                for inner in nested:
                    inner[3].update(assignments)
                return nested

    return [(written, name, args, assignments)]


def is_global(name, args):
    """True for an adb subcommand that affects every agent, whatever the serial."""
    if name != "adb":
        return False
    index = 0
    while index < len(args):
        arg = args[index]
        if arg in ("-d", "-e"):
            return True
        if arg == "-s" and index + 1 < len(args):
            index += 2
            continue
        if arg.startswith("-"):
            index += 1
            continue
        return arg in GLOBAL_SUBCOMMANDS
    return False


def subcommand(args):
    return next((a for a in args if not a.startswith("-")), None)


def classify(name, args):
    """The device-touching kind of one simple command, or None."""
    if name == "adb":
        return None if subcommand(args) in ADB_LOCAL else "adb"
    if name in ("gradle", "gradlew"):
        tasks = (a.rsplit(":", 1)[-1] for a in args if not a.startswith("-"))
        return "gradle" if any(GRADLE_TASK.match(t) for t in tasks) else None
    if name == "maestro":
        return None if subcommand(args) in MAESTRO_LOCAL else "maestro"
    if name == "android":
        return "android" if subcommand(args) in ANDROID_DEVICE_SUBCOMMANDS else None
    return None


def serial_of(args, assignments, kind):
    for index, arg in enumerate(args):
        if arg.startswith("--device="):
            return arg.split("=", 1)[1]
        if arg.startswith("-Pdevice="):
            return arg.split("=", 1)[1]
        if arg == "--device" and index + 1 < len(args):
            return args[index + 1]
        if kind == "adb" and arg == "-s" and index + 1 < len(args):
            return args[index + 1]
    # The hook inherits the agent's env, but not a serial assigned inline.
    if assignments.get("ANDROID_SERIAL"):
        return assignments["ANDROID_SERIAL"]
    if os.environ.get("ANDROID_SERIAL"):
        return os.environ["ANDROID_SERIAL"]
    devices = attached()
    return devices[0] if len(devices) == 1 else None


def attached():
    override = os.environ.get("DEVLEASE_DEVICES")
    if override is not None:
        return override.split()
    try:
        import subprocess
        out = subprocess.run(["adb", "devices"], capture_output=True, text=True, timeout=10).stdout
    except Exception:
        return []
    return [l.split()[0] for l in out.splitlines()[1:] if "\tdevice" in l]


def age(path):
    return time.time() - os.stat(path).st_mtime


def acquire(serial, cwd):
    """Return (ok, message). message is a warning on success, a reason on failure."""
    os.makedirs(DIR, exist_ok=True)
    lease = os.path.join(DIR, serial)
    stamp = lease + ".last"
    deadline = time.time() + WAIT
    while True:
        try:
            os.mkdir(lease)
        except FileExistsError:
            try:
                owner = open(os.path.join(lease, "owner")).read().strip()
                held = open(os.path.join(lease, "since")).read().strip()
            except OSError:
                owner, held = "", ""
            if owner == ME:
                os.utime(lease, None)
                return True, None
            if age(lease) > TTL:
                shutil.rmtree(lease, ignore_errors=True)
                continue
            if time.time() >= deadline:
                where = ""
                try:
                    where = " in " + open(os.path.join(lease, "cwd")).read().strip()
                except OSError:
                    pass
                mins = int(age(lease) // 60)
                return False, (
                    f"{serial} is held by another agent (session {owner[:8]}{where}), "
                    f"idle {mins}m, since {held}. Run `devlease list` to see all leases. "
                    "Work on something else and retry, or ask the user to run "
                    f"`devlease steal {serial}`."
                )
            time.sleep(2)
            continue

        previous = ""
        if os.path.exists(stamp):
            previous = open(stamp).read().strip()
        for name, value in (("owner", ME), ("cwd", cwd),
                            ("since", time.strftime("%H:%M"))):
            open(os.path.join(lease, name), "w").write(value)
        open(stamp, "w").write(ME)
        notice = (
            f"You now hold the lease on {serial}. Other agents are blocked from it until "
            f"you run `devlease release {serial}` — do that as soon as you are done with "
            "the device."
        )
        if previous and previous != ME:
            notice = (
                f"Device {serial} state changed: session {previous[:8]} held it since you "
                "last did. Whatever you installed or set up on it may be gone. Reinstall "
                "and re-establish app state before trusting anything you see.\n" + notice
            )
        return True, notice


DEVICE_TOOLS = re.compile(r"(?:^|[\s/\"'(;&|`])(?:adb|maestro|gradlew|android)(?:[\s);&|`]|$)")


def gate(cmd, cwd, alone=True):
    rules = load_rules(cwd)
    parsed = segments(cmd)
    if parsed is None:
        if DEVICE_TOOLS.search(cmd):
            return "deny", (
                "devlease could not parse this command (unbalanced quotes?) and it "
                "names an Android device tool, so it cannot tell which device the "
                "command would touch. Rewrite it so it parses, or split it up."
            )
        return "allow", None

    notices = []
    for written, name, args, assignments in parsed:
        text = " ".join([written] + args)

        # Released here because a Codex shell has no CLAUDE_CODE_SESSION_ID; it happens
        # before anything runs, so device work chained or batched with it would lose its lease.
        # ponytail: also refuses `cd x && devlease release`; narrow to chains with a gated segment.
        if name == "devlease" and args[:1] == ["release"]:
            if len(parsed) > 1 or not alone:
                return "deny", (
                    "Run `devlease release [serial]` as a command of its own. The hook "
                    "releases before any of the command runs, so anything chained with "
                    "it would run on a device you no longer hold."
                )
            target = args[1] if len(args) > 1 else None
            freed = release(ME, target)
            notices.append(
                f"Released {', '.join(freed)}." if freed else
                f"This session holds no lease{' on ' + target if target else 's'} to release."
            )
            continue

        hit = matches(rules["denied"], text)
        if hit:
            return "deny", (
                f"Refused by a `denied` rule: {hit}. This command is configured as "
                "never-allowed here, usually because it disrupts other agents. Ask "
                "the user to run it themselves if it is genuinely needed."
            )
        if is_global(name, args):
            return "deny", (
                "Global adb operations (kill-server, start-server, root, reboot, "
                "usb, tcpip, disconnect, -d, -e) break other agents sharing this adb "
                "server. Ask the user to run it themselves if it is genuinely needed."
            )

        kind = classify(name, args)
        emulator_only = matches(rules["emulator_only"], text)
        if not kind and not (emulator_only or matches(rules["gated"], text)):
            continue

        serial = serial_of(args, assignments, kind)
        if not serial:
            count = len(attached())
            situation = ("no devices are attached" if count == 0
                         else "more than one is attached")
            return "deny", (
                f"Cannot tell which device `{name}` targets, and {situation}. Set "
                "ANDROID_SERIAL, or pass the target explicitly: `adb -s <serial>`, "
                "`--device <serial>` for maestro, `--device=<serial>` for the android "
                "CLI, `-Pdevice=<serial>` for a Gradle task that takes one. Run `adb "
                "devices` to list them."
            )
        if emulator_only and not serial.startswith("emulator-"):
            return "deny", (
                f"{serial} is a physical device, and an `emulator_only` rule restricts "
                f"this command to emulators: {emulator_only}. Target an emulator "
                "instead — `adb devices` lists them as emulator-<port>."
            )

        ok, message = acquire(serial, cwd)
        if not ok:
            return "deny", message
        if message:
            notices.append(message)

    return "allow", "\n".join(notices) or None


def hook():
    payload = json.load(sys.stdin)
    tool_input = payload.get("tool_input") or {}
    cwd = payload.get("cwd", "")
    global ME
    ME = payload.get("session_id") or ME

    if payload.get("hook_event_name") == "SessionEnd":
        release(ME)
        return

    commands = []
    shell = tool_input.get("language", "shell") in SHELLS | {"shell"}
    for key in ("command", "code") if shell else ("command",):
        if isinstance(tool_input.get(key), str):
            commands.append(tool_input[key])
    # context-mode v1 batches send {"label", "command"} objects, v2 plain strings.
    for entry in tool_input.get("commands") or []:
        if isinstance(entry, dict):
            entry = entry.get("command")
        if isinstance(entry, str):
            commands.append(entry)

    warnings = []
    for cmd in commands:
        decision, message = gate(cmd, cwd, len(commands) == 1)
        if decision == "deny":
            emit(permissionDecision="deny", permissionDecisionReason=message)
            return
        if message:
            warnings.append(message)
    if warnings:
        emit(additionalContext="\n".join(warnings))


def emit(**fields):
    fields["hookEventName"] = "PreToolUse"
    print(json.dumps({"hookSpecificOutput": fields}))


def leases():
    if not os.path.isdir(DIR):
        return []
    out = []
    for name in sorted(os.listdir(DIR)):
        path = os.path.join(DIR, name)
        if not os.path.isdir(path):
            continue
        try:
            owner = open(os.path.join(path, "owner")).read().strip()
        except OSError:
            owner = "?"
        out.append((name, path, owner))
    return out


def release(session, target=None):
    """Remove the leases session holds, or only the one on target. Returns their names."""
    freed = []
    for name, path, owner in leases():
        if owner == session and (target is None or name == target):
            shutil.rmtree(path, ignore_errors=True)
            freed.append(name)
    return freed


def main():
    mode = sys.argv[1] if len(sys.argv) > 1 else "hook"
    if mode == "hook":
        try:
            hook()
        except Exception as exc:  # never block a tool call on a bug in here
            print(f"devlease: {exc}", file=sys.stderr)
        return 0
    if mode == "list":
        for name, path, owner in leases():
            mine = " (you)" if owner == ME else ""
            print(f"{name}  session {owner[:8]}{mine}  idle {int(age(path) // 60)}m")
        return 0
    if mode == "release":
        for name in release(ME, sys.argv[2] if len(sys.argv) > 2 else None):
            print(f"released {name}")
        return 0
    if mode == "steal":
        if len(sys.argv) < 3:
            print("usage: devlease steal <serial>", file=sys.stderr)
            return 2
        shutil.rmtree(os.path.join(DIR, sys.argv[2]), ignore_errors=True)
        print(f"stole {sys.argv[2]}")
        return 0
    print("usage: devlease [hook|list|release [serial]|steal <serial>]", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
